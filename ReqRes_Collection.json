        {
          "name": "POST - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// Kiểm tra trường name và job khớp với file CSV\r",
                  "pm.test(\"Validate name and job from iterationData\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.name).to.eql(pm.iterationData.get(\"name\"));\r",
                  "    pm.expect(jsonData.job).to.eql(pm.iterationData.get(\"job\"));\r",
                  "});\r",
                  "\r",
                  "// Trích xuất id trả về gán vào biến môi trường\r",
                  "var jsonData = pm.response.json();\r",
                  "pm.environment.set(\"userId\", jsonData.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"{{name}}\",\r\n    \"job\": \"{{job}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
